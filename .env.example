# --- Required in production -------------------------------------------------
# Random string (>= 32 chars) used to sign download tokens. Generate: openssl rand -hex 32
APP_SECRET=

# --- Official source: Instagram API with Facebook Login ---------------------
# Token + IG user id of YOUR OWN Instagram Business/Creator account (linked to a Facebook Page).
# Enables: your own media (full), and other Business/Creator accounts via Business Discovery.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v25.0

# --- Official source: oEmbed (preview only, never downloadable) -------------
# Optional app access token "APP_ID|APP_SECRET". Meta's changelog says a token is no longer
# required (May 2026); verify against current docs.
OEMBED_ACCESS_TOKEN=

# --- Optional: separately operated, lawful external source ------------------
# Must implement the contract in docs/EXTERNAL_SOURCE.md
EXTERNAL_SOURCE_URL=
EXTERNAL_SOURCE_TOKEN=

# --- Limits & safety ---------------------------------------------------------
# Extra hostnames (comma separated, suffix match) media may be fetched from.
# Built-in: cdninstagram.com, fbcdn.net
MEDIA_HOST_ALLOWLIST=
MAX_FILE_MB=200
MAX_ITEMS_PER_RESOLVE=100
MAX_ZIP_FILES=200
JOB_TTL_MINUTES=30
